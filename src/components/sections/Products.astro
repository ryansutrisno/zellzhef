---
import { Image } from 'astro:assets';
import { products, decorativeImages } from '../../data/copy';
---

<section class="py-16 px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto" id="produk">
  <div class="flex justify-between items-end mb-8 animate-on-scroll">
    <h2 class="text-headline-md font-headline-md text-on-background">Hardware Unggulan</h2>
    <span class="text-label-mono font-label-mono text-secondary px-3 py-1 bg-surface-container rounded-full shadow-inner">STOCK_READY</span>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4">
    {products.map((product, index) => {
      const isLarge = product.size === 'large';
      return (
        <div class={`${isLarge ? 'md:col-span-2 flex-col md:flex-row' : 'flex-col'} bg-surface border border-circuit-gray rounded overflow-hidden flex group hover:shadow-xl hover:-translate-y-1 transition-all duration-300 animate-on-scroll stagger-${(index % 4) + 1} cursor-pointer`}>
          <div class={`${isLarge ? 'w-full md:w-1/2 h-48 md:h-full' : 'h-40'} bg-surface-dim relative overflow-hidden`}>
            <Image class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110" src={product.image} alt={product.name} loading="lazy" decoding="async" />
          </div>
          <div class={`p-${isLarge ? '6' : '4'} flex-1 flex flex-col justify-${isLarge ? 'center' : 'between'} bg-surface group-hover:bg-surface-container-lowest transition-colors`}>
            {product.badge && (
              <span class="inline-block bg-success-mint text-on-surface px-2 py-1 rounded text-label-caps font-label-caps w-max mb-3 shadow-sm">{product.badge}</span>
            )}
            <div>
              <h3 class={`${isLarge ? 'text-headline-md font-headline-md mb-2' : 'text-body-lg font-headline-md'} text-on-surface group-hover:text-primary transition-colors`}>
                {product.name}
              </h3>
              <p class={`text-label-mono font-label-mono text-on-surface-variant ${isLarge ? 'mb-4' : 'mt-1'}`}>{product.spec}</p>
            </div>
            {isLarge && (
              <button class="text-primary font-label-caps text-label-caps tracking-wider border border-primary/20 hover:border-primary hover:bg-primary/5 w-max px-4 py-2 rounded transition-all active:scale-95">
                LIHAT DETAIL
              </button>
            )}
          </div>
        </div>
      );
    })}
  </div>

  <div class="mt-8 flex flex-col md:flex-row gap-4 animate-on-scroll">
    <div class="flex-1 bg-surface border border-circuit-gray rounded p-4 flex items-center gap-4 hover:shadow-lg hover:border-primary/30 transition-all group cursor-pointer">
      <div class="w-16 h-16 shrink-0 rounded overflow-hidden bg-surface-dim">
        <Image class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src={decorativeImages.macbook} alt="MacBook Repair" loading="lazy" decoding="async" />
      </div>
      <div>
        <h4 class="text-body-md font-headline-md group-hover:text-primary transition-colors">MacBook Repair</h4>
        <p class="text-label-mono font-label-mono text-secondary">Diagnostic & Fix</p>
      </div>
    </div>
    <div class="flex-1 bg-surface border border-circuit-gray rounded p-4 flex items-center gap-4 hover:shadow-lg hover:border-primary/30 transition-all group cursor-pointer">
      <div class="w-16 h-16 shrink-0 rounded overflow-hidden bg-surface-dim">
        <Image class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" src={decorativeImages.ipad} alt="iPad Repair" loading="lazy" decoding="async" />
      </div>
      <div>
        <h4 class="text-body-md font-headline-md group-hover:text-primary transition-colors">iPad Repair</h4>
        <p class="text-label-mono font-label-mono text-secondary">Screen & Battery</p>
      </div>
    </div>
  </div>
</section>
