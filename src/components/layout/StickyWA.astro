---
import { stickyWA, config } from '../../data/copy';
---

<a class="fixed bottom-20 md:bottom-8 right-4 md:right-8 bg-primary-container text-on-primary w-14 h-14 rounded-full flex items-center justify-center shadow-lg hover:shadow-xl hover:scale-110 hover:-translate-y-1 transition-all duration-300 z-50 animate-bounce" href={`https://wa.me/${config.whatsapp}?text=${encodeURIComponent(stickyWA.waMessage)}`} style="animation-duration: 3s;" aria-label="Contact via WhatsApp">
  <span class="material-symbols-outlined text-3xl">chat</span>
</a>
