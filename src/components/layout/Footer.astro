---
import { footer, brand } from '../../data/copy';
---

<footer class="bg-surface-container-highest w-full mt-auto border-t border-outline-variant">
  <div class="px-margin-mobile md:px-margin-desktop py-12 max-w-max-width mx-auto animate-on-scroll">
    <div class="text-headline-md font-headline-md font-bold text-primary mb-4">
      {brand.name}
    </div>
    <p class="text-body-md font-body-md text-on-surface-variant">
      {footer.text} <a href={footer.poweredByUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline underline-offset-4 transition-colors font-medium">{footer.poweredBy}</a>
    </p>
  </div>
</footer>
