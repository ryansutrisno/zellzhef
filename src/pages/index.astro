---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import StickyWA from '../components/layout/StickyWA.astro';
import ScrollReveal from '../components/shared/ScrollReveal.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Products from '../components/sections/Products.astro';
import Process from '../components/sections/Process.astro';
import Location from '../components/sections/Location.astro';
---

<BaseLayout>
  <ScrollReveal />
  <Navbar />
  <main class="flex-grow pt-16 md:pt-0">
    <Hero />
    <Services />
    <Products />
    <Process />
    <Location />
  </main>
  <Footer />
  <StickyWA />
</BaseLayout>
